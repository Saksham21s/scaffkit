{
  "name": "scaffkit",
  "version": "0.1.1",
  "description": "Production-grade React project scaffolding from a single CLI command. Generates complete applications with API client, design tokens, state management, routing, and feature modules.",
  "keywords": [
    "react",
    "scaffold",
    "cli",
    "typescript",
    "code-generation",
    "vite",
    "tailwind",
    "axios",
    "tanstack-query",
    "zustand"
  ],
  "license": "MIT",
  "author": "scaffkit Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saksham21s/scaffkit.git"
  },
  "homepage": "https://github.com/Saksham21s/scaffkit#readme",
  "bugs": {
    "url": "https://github.com/Saksham21s/scaffkit/issues"
  },
  "type": "module",
  "bin": {
    "scaffkit": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --minify",
    "preview": "npm run build && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.0",
    "chalk": "^5.4.0",
    "commander": "^12.1.0",
    "ejs": "^3.1.10",
    "fs-extra": "^11.2.0",
    "ora": "^8.1.1",
    "prettier": "^3.4.2",
    "validate-npm-package-name": "^6.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
